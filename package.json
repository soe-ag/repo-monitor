{
  "name": "repo-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "build": "next build",
